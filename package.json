{
  "name": "fusion-associations-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fusion Associations Live - automated multi-level association game for TikTok Live (Mobile Gaming screen share).",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "render-build": "npm install && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tiktok-live-connector": "^1.2.0",
    "vite": "^5.4.0"
  }
}
